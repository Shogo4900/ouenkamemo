# Notionインテグレーションのシークレットキー
# https://www.notion.so/my-integrations で取得
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NotionデータベースのID（URLの末尾部分）
# 例: https://www.notion.so/1ab8b9006adc825891ad81d43963eab0 → 1ab8b9006adc825891ad81d43963eab0
NOTION_DATABASE_ID=1ab8b9006adc825891ad81d43963eab0
